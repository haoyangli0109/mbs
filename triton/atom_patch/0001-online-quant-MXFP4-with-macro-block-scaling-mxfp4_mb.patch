+def gemm_mxfp4_mbs_fake(
+    x: torch.Tensor,
+    x_scale: torch.Tensor | None,
+    weight: torch.Tensor,
+    weight_scale: torch.Tensor,
+    weight_mbs_ratio: torch.Tensor | None,
+    weight_mbs_sigma: torch.Tensor | None,
+    otype: torch.dtype,
+    mbs_block: int,
+    act_mbs: bool,
+) -> torch.Tensor:
+    return torch.empty((*x.shape[:-1], weight.shape[0]), dtype=otype, device=x.device)
+
+
+@torch_compile_guard(gen_fake=gemm_mxfp4_mbs_fake, mutates_args=[])
+def gemm_mxfp4_mbs(
+    x: torch.Tensor,
+    x_scale: torch.Tensor | None,
+    weight: torch.Tensor,
+    weight_scale: torch.Tensor,
+    weight_mbs_ratio: torch.Tensor | None,
+    weight_mbs_sigma: torch.Tensor | None,
+    otype: torch.dtype,
+    mbs_block: int,
+    act_mbs: bool,
+) -> torch.Tensor:
+    """MXFP4 GEMM with macro block scaling (Triton, see `mxfp4_mbs`).
+
+    A float `x` is quantized here, with static macro-block factors when
+    `act_mbs`. An already-quantized `x` (`x_scale` set by a fused norm+quant)
+    is plain MXFP4 with aiter's shuffled scales and carries no factors.
+    `weight` is preshuffled fp4x2 [N, K/2] and `weight_scale` shuffled E8M0;
+    the weight's factors enter as `weight_mbs_ratio` [K/mbs_block, N]
+    (f[kb]/f[kb-1]) and `weight_mbs_sigma` [N] (1/f of the last block), fp32,
+    or None when only the activations carry factors.
+    """
+    lead = x.shape[:-1]
+    x2 = x.reshape(-1, x.shape[-1])
+    n, k = weight.shape[0], 2 * weight.shape[1]
+    w = {
+        "q": weight.view(torch.uint8),
+        "s": weight_scale.view(torch.uint8),
+        "ratio": weight_mbs_ratio,
+        "sigma_last": weight_mbs_sigma,
+    }
+    if x_scale is None:
+        a = mxfp4_mbs.quant_activation(x2, mb=mbs_block, use_mbs=act_mbs)
+    else:
+        a = {
+            "q": x2.view(torch.uint8),
+            "s": x_scale.view(torch.uint8),
+            "s_shuffled": True,
+            "ratio": None,
+        }
+    cfg = mxfp4_mbs.select_config(
+        x2.shape[0],
+        n,
+        k,
+        mbs_block,
+        a["ratio"] is not None,
+        weight_mbs_ratio is not None,
+    )
+    if a["s_shuffled"] and cfg["BLOCK_M"] < 32:
+        cfg = dict(cfg, BLOCK_M=32)
+    y = mxfp4_mbs.mbs_gemm(a, w, mb=mbs_block, out_dtype=otype, config=cfg)
+    return y.view(*lead, n)
+
+
+def quant_weight_online_mbs(
+    weight: torch.Tensor, spec, prefix: str = ""
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor | None]:
+    """MXFP4 + MBS weight quantization: (fp4x2 [N, K/2], E8M0 [N, K/32],
+    E0M8 mantissas [N, K/block] or None when the weight side has no factors)."""
+    if weight.dim() != 2 or weight.shape[-1] % max(spec.block, 256):
+        raise ValueError(
+            f"{prefix}: MXFP4 macro block scaling needs a 2D GEMM weight with K "
+            f"divisible by max({spec.block}, 256), got shape {tuple(weight.shape)}. "
+            "Add the layer to exclude_layer."
+        )
+    q, s, m = mxfp4_mbs.mbs_quant(
+        weight.contiguous(),
+        mb=spec.block,
+        ncand=envs.ATOM_MBS_WEIGHT_CANDIDATES if spec.weight else 1,
+        use_mbs=spec.weight,
+    )
+    return q.view(dtypes.fp4x2), s.view(dtypes.fp8_e8m0), m
+
